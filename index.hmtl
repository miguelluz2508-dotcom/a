<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Para o amor da minha vida!</title>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">
    
    <!-- FontAwesome (Ícones) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        'love-bg': '#fff5f7',
                        'love-pink': '#d63384',
                        'love-dark': '#2c1e28',
                        'love-card': '#ffe4ef',
                    },
                    fontFamily: {
                        serif: ['"Playfair Display"', 'serif'],
                        sans: ['"Poppins"', 'sans-serif'],
                    }
                }
            }
        }
    </script>

    <style>
        body {
            background: radial-gradient(circle at top, #fff5f7 0%, #fff 100%);
            min-height: 100vh;
            overflow-x: hidden;
            position: relative;
        }

        .floating-element {
            position: fixed;
            bottom: -20px;
            pointer-events: none;
            z-index: 0;
            opacity: 0;
            animation: floatUp linear forwards;
        }

        @keyframes floatUp {
            0% { transform: translateY(0) scale(0.8) rotate(0deg); opacity: 0; }
            10% { opacity: 0.3; }
            90% { opacity: 0.3; }
            100% { transform: translateY(-100vh) scale(1.2) rotate(45deg); opacity: 0; }
        }

        .text-gradient {
            background: linear-gradient(180deg, #4a3040 0%, #a83271 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .soft-shadow {
            box-shadow: 0 10px 40px -10px rgba(214, 51, 132, 0.15);
        }
        
        .pulse-btn:hover {
            transform: scale(1.02);
            box-shadow: 0 0 20px rgba(214, 51, 132, 0.4);
        }
        
        /* ANIMAÇÕES DO CORAÇÃO LUXUOSO */
        .heart-path {
            stroke-dasharray: 100;
            stroke-dashoffset: 100;
            animation: 
                drawHeart 2.5s ease-out forwards, 
                fillHeart 0.8s ease-in 2.6s forwards;
        }

        .beating {
            animation: beatHeart 1.4s infinite ease-in-out;
            transform-origin: center;
        }

        @keyframes drawHeart {
            to { stroke-dashoffset: 0; }
        }

        @keyframes fillHeart {
            to { fill: url(#luxuryGradient); stroke: rgba(255, 255, 255, 0.5); stroke-width: 0.2; }
        }

        @keyframes beatHeart {
            0%, 100% { transform: scale(1); filter: drop-shadow(0 0 15px rgba(214, 51, 132, 0.4)); }
            25% { transform: scale(1.08); filter: drop-shadow(0 0 30px rgba(255, 71, 126, 0.7)); }
            40% { transform: scale(1); filter: drop-shadow(0 0 15px rgba(214, 51, 132, 0.4)); }
            60% { transform: scale(1.12); filter: drop-shadow(0 0 35px rgba(255, 71, 126, 0.9)); }
        }
        
        #btn-no {
            transition: top 0.2s ease, left 0.2s ease, font-size 0.2s ease, padding 0.2s ease;
        }
    </style>
</head>
<body class="font-sans text-love-dark selection:bg-love-pink selection:text-white pb-20">

    <div id="hearts-container"></div>

    <main class="relative z-10 max-w-4xl mx-auto px-4 pt-16 md:pt-24 flex flex-col items-center">
        
        <h1 class="font-serif text-5xl md:text-6xl lg:text-7xl font-bold text-center text-slate-800 tracking-tight leading-tight mb-4">
            Para o amor da<br>minha vida!
        </h1>
        
        <div class="flex items-center gap-2 text-love-pink/70 font-medium text-sm md:text-base mt-2 mb-10">
            <i class="fa-regular fa-calendar"></i>
            <span id="start-date-text">Juntos desde...</span>
        </div>

        <div class="flex gap-4 md:gap-8 justify-center mb-10">
            <div class="bg-[#fef0f5] soft-shadow rounded-3xl p-6 md:p-8 w-32 md:w-40 flex flex-col items-center justify-center border border-white/50">
                <span class="font-serif text-6xl md:text-7xl font-bold text-gradient" id="count-months">2</span>
                <span class="text-[10px] md:text-xs tracking-[0.2em] uppercase text-love-pink mt-3 font-semibold">Meses</span>
            </div>
            <div class="bg-[#fef0f5] soft-shadow rounded-3xl p-6 md:p-8 w-32 md:w-40 flex flex-col items-center justify-center border border-white/50">
                <span class="font-serif text-6xl md:text-7xl font-bold text-gradient" id="count-days">11</span>
                <span class="text-[10px] md:text-xs tracking-[0.2em] uppercase text-love-pink mt-3 font-semibold">Dias</span>
            </div>
        </div>

        <div class="bg-[#fef0f5] border border-[#fce4ee] rounded-full px-8 py-3 mb-6 soft-shadow">
            <span class="font-mono text-xl md:text-2xl text-love-pink tracking-widest font-medium">
                <span id="hours">00</span> : <span id="minutes">00</span> : <span id="seconds">00</span>
            </span>
        </div>

        <div class="flex items-center gap-2 text-love-pink/80 mt-2 mb-20 text-sm md:text-base">
            <i class="fa-solid fa-sparkles text-xs"></i>
            <span>São <strong id="total-days" class="text-love-dark font-semibold">72</strong> dias de amor</span>
            <i class="fa-solid fa-sparkles text-xs"></i>
        </div>

        <!-- MÚSICA -->
        <div class="w-full max-w-md bg-[#fef0f5] rounded-[2rem] p-8 md:p-10 flex flex-col items-center border border-white/60 soft-shadow mb-20 transition-all duration-500">
            <div class="text-love-pink text-2xl mb-3 flex gap-2">
                <i class="fa-solid fa-music"></i>
            </div>
            <h2 class="font-serif text-2xl md:text-3xl font-bold text-slate-800 mb-2">Nossa Música</h2>
            <p class="text-sm text-gray-500 mb-8">A trilha sonora do nosso amor</p>
            
            <button id="play-btn" onclick="revealMusic()" class="w-full bg-[#d83f7a] hover:bg-[#c2326b] text-white font-medium py-4 rounded-2xl flex items-center justify-center gap-3 transition-all duration-300 pulse-btn">
                <i class="fa-solid fa-play"></i>
                Clique para descobrir
            </button>

            <div id="spotify-player" class="w-full hidden animate-[fadeIn_0.5s_ease-out]">
                <iframe 
                    style="border-radius:12px" 
                    src="https://open.spotify.com/embed/track/3QA7VF91ehKfoYEDa5wcJb?utm_source=generator&theme=0" 
                    width="100%" 
                    height="152" 
                    frameBorder="0" 
                    allowfullscreen="" 
                    allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture" 
                    loading="lazy">
                </iframe>
                <div class="mt-4 flex justify-center gap-4 text-love-pink/40 text-xs">
                    <i class="fa-solid fa-music"></i>
                    <i class="fa-solid fa-music"></i>
                    <i class="fa-solid fa-music"></i>
                </div>
            </div>
        </div>

        <!-- CARTA E PERGUNTA -->
        <div class="w-full max-w-2xl bg-gradient-to-br from-[#fef0f5] to-white rounded-[2rem] p-8 md:p-12 border border-[#fce4ee] soft-shadow relative mb-10">
            <div class="absolute -top-6 -left-2 text-7xl font-serif text-love-pink opacity-20">"</div>
            <div class="absolute -bottom-10 -right-2 text-7xl font-serif text-love-pink opacity-20">"</div>
            
            <p class="text-center font-medium text-lg md:text-xl text-slate-700 leading-relaxed md:leading-loose relative z-10">
                Sério, desde o primeiro dia q a gnt começou a conversar, slá, algo mudou mt em mim. Eu já sabia q vc ia ser especial tlgd? Cada momentinho nosso é perfeito, tipo, seu sorriso melhora o meu dia 1000%. Vc é literalmente tudo pra mim, meu porto seguro real. Só qro continuar contando esses dias, meses e anos ctg pra sempre. Te amo mt!
                <br><br>
                <strong class="text-love-pink text-2xl md:text-3xl font-serif block mt-4 animate-pulse">Aceita ficar comigo?</strong>
            </p>
            
            <div class="mt-10 flex items-center justify-center gap-4 md:gap-6 relative min-h-[60px]" id="proposal-buttons">
                <button id="btn-yes" onclick="acceptProposal()" class="bg-[#d83f7a] hover:bg-[#c2326b] text-white font-bold py-3.5 px-10 rounded-full shadow-lg transition-transform hover:scale-110 z-20 pulse-btn text-lg">
                    Sim! 🥰
                </button>
                
                <button id="btn-no" onmouseover="dodgeButton()" onclick="dodgeButton()" ontouchstart="dodgeButton()" class="bg-white text-love-pink border-2 border-love-pink/50 hover:bg-red-50 font-bold py-3.5 px-8 rounded-full shadow z-10 text-lg whitespace-nowrap">
                    Não
                </button>
            </div>
        </div>

    </main>

    <!-- TELA DE SUCESSO APRIMORADA -->
    <div id="success-overlay" class="fixed inset-0 bg-gradient-to-b from-[#fff5f7] via-[#ffe4ef] to-[#ffc8dd] z-50 hidden flex-col items-center justify-center backdrop-blur-md overflow-hidden">
        
        <!-- Orbes de luz decorativos -->
        <div class="absolute w-96 h-96 bg-pink-400/20 blur-[120px] rounded-full -top-20 -left-20 animate-pulse"></div>
        <div class="absolute w-96 h-96 bg-rose-500/20 blur-[120px] rounded-full -bottom-20 -right-20 animate-pulse"></div>

        <div class="relative z-10 text-center px-4 flex flex-col items-center max-w-xl">
            
            <h2 class="font-serif text-3xl md:text-5xl text-love-pink mb-3 font-bold opacity-0 animate-[fadeIn_1s_ease-out_3s_forwards] drop-shadow">
                Eu sabia que vc ia aceitar! ❤️
            </h2>
            
            <p class="font-sans text-base md:text-lg text-slate-700 mb-8 opacity-0 animate-[fadeIn_1s_ease-out_4s_forwards] font-medium leading-relaxed">
                Agora oficialmente juntos e para sempre. Cada segundo com você é o meu momento favorito do dia. Prometo te fazer a pessoa mais feliz do mundo inteiro! ✨
            </p>

            <!-- Coração Ultra Estilizado SVG com Glow Dinâmico -->
            <svg id="beautiful-heart" class="w-56 h-56 md:w-72 md:h-72 drop-shadow-[0_10px_25px_rgba(214,51,132,0.5)] overflow-visible mb-6" viewBox="0 0 24 24" fill="transparent" xmlns="http://www.w3.org/2000/svg">
                <defs>
                    <linearGradient id="luxuryGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                        <stop offset="0%" stop-color="#ff758c" />
                        <stop offset="50%" stop-color="#ff7eb3" />
                        <stop offset="100%" stop-color="#c81d77" />
                    </linearGradient>
                    <filter id="superGlow" x="-50%" y="-50%" width="200%" height="200%">
                        <feGaussianBlur stdDeviation="1.5" result="blur" />
                        <feComponentTransfer in="blur" result="glow1">
                            <feFuncA type="linear" slope="1.5"/>
                        </feComponentTransfer>
                        <feMerge>
                            <feMergeNode in="glow1"/>
                            <feMergeNode in="SourceGraphic"/>
                        </feMerge>
                    </filter>
                </defs>
                <path class="heart-path" filter="url(#superGlow)" d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" stroke="url(#luxuryGradient)" stroke-width="0.3" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>

            <!-- Assinatura / Frase final romântica -->
            <div class="opacity-0 animate-[fadeIn_1s_ease-out_5s_forwards]">
                <span class="inline-block px-6 py-2 rounded-full bg-white/60 border border-white text-love-pink font-serif italic text-sm shadow-sm">
                    Te amo infinito e além ♾️💖
                </span>
            </div>
            
        </div>
    </div>

    <script>
        const startDate = new Date();
        startDate.setMonth(startDate.getMonth() - 2);
        startDate.setDate(startDate.getDate() - 11);
        
        const options = { day: 'numeric', month: 'long', year: 'numeric' };
        document.getElementById('start-date-text').innerText = `Juntos desde ${startDate.toLocaleDateString('pt-BR', options)}`;

        function updateCounter() {
            const now = new Date();
            const diff = now - startDate;
            
            const totalDays = Math.floor(diff / (1000 * 60 * 60 * 24));
            
            let years = now.getFullYear() - startDate.getFullYear();
            let months = now.getMonth() - startDate.getMonth();
            let days = now.getDate() - startDate.getDate();
            
            if (days < 0) {
                months--;
                const prevMonth = new Date(now.getFullYear(), now.getMonth(), 0);
                days += prevMonth.getDate();
            }
            if (months < 0) {
                years--;
                months += 12;
            }
            
            const totalMonths = (years * 12) + months;
            
            const hours = now.getHours().toString().padStart(2, '0');
            const minutes = now.getMinutes().toString().padStart(2, '0');
            const seconds = now.getSeconds().toString().padStart(2, '0');
            
            document.getElementById('count-months').innerText = totalMonths;
            document.getElementById('count-days').innerText = days;
            document.getElementById('hours').innerText = hours;
            document.getElementById('minutes').innerText = minutes;
            document.getElementById('seconds').innerText = seconds;
            document.getElementById('total-days').innerText = totalDays;
        }

        function revealMusic() {
            document.getElementById('play-btn').style.display = 'none';
            document.getElementById('spotify-player').style.display = 'block';
        }

        let currentScale = 1;
        const noPhrases = [
            "ops 🤭",
            "tente novamente",
            "coe me da uma chance 😔",
            "certeza?",
            "foge não!",
            "botão errado rs",
            "qualé kkk"
        ];

        function dodgeButton() {
            const btnNo = document.getElementById('btn-no');
            
            currentScale = currentScale * 0.90;
            if(currentScale < 0.3) currentScale = 0.3;
            
            btnNo.style.transform = `scale(${currentScale})`;
            
            const randomText = noPhrases[Math.floor(Math.random() * noPhrases.length)];
            btnNo.innerText = randomText;
            
            btnNo.style.position = 'fixed';
            
            const padding = 30;
            const maxX = window.innerWidth - (btnNo.offsetWidth * currentScale) - padding;
            const maxY = window.innerHeight - (btnNo.offsetHeight * currentScale) - padding;
            
            const newX = Math.max(padding, Math.random() * maxX);
            const newY = Math.max(padding, Math.random() * maxY);

            btnNo.style.left = `${newX}px`;
            btnNo.style.top = `${newY}px`;
        }

        function acceptProposal() {
            document.body.style.overflow = 'hidden';
            
            const overlay = document.getElementById('success-overlay');
            overlay.classList.remove('hidden');
            overlay.classList.add('flex');
            
            setTimeout(() => {
                document.getElementById('beautiful-heart').classList.add('beating');
            }, 3000);
            
            for(let i=0; i<35; i++) {
                setTimeout(createHeart, i * 90);
            }
        }

        function createHeart() {
            const heart = document.createElement('div');
            heart.classList.add('floating-element');
            
            const icons = ['💗', '✨', '💖', '🌸', '❤️'];
            heart.innerText = icons[Math.floor(Math.random() * icons.length)];
            
            heart.style.left = Math.random() * 100 + 'vw';
            heart.style.fontSize = (Math.random() * 16 + 12) + 'px';
            heart.style.animationDuration = (Math.random() * 4 + 4) + 's';
            heart.style.zIndex = Math.random() > 0.5 ? '0' : '60';
            
            document.body.appendChild(heart);
            
            setTimeout(() => {
                heart.remove();
            }, 8000);
        }

        setInterval(updateCounter, 1000);
        updateCounter();
        setInterval(createHeart, 1000);

    </script>
</body>
</html>
